<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all styling. This shell only removes the platform action bar
         and paints the window while the first frame is composing. -->
    <style name="Theme.GearLoop" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/chalk_100</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- The system splash: the gear tag on pine, on every API level. It hands
         over to Theme.GearLoop as soon as the app's own splash can draw. -->
    <style name="Theme.GearLoop.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pine_900</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.GearLoop</item>
    </style>
</resources>
