# This repo is authored on Windows with core.autocrlf=true. Two files care about
# line endings for reasons that only show up on someone else's machine:
# gradlew is a shell script and will not run with CRLF, and gradlew.bat is a
# batch file that wants them.
* text=auto

gradlew text eol=lf
*.bat text eol=crlf
*.sh text eol=lf

# Screenshots, wireframes and the packaged photography — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
