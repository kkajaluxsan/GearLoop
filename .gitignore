*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/captures
.externalNativeBuild
.cxx
local.properties

# Build output. The original rule was `/build`, which only matches the root —
# app/build is 247 MB and would have gone straight into the first commit.
build/
.kotlin/

# Agent tooling. .claude/skills holds symlinks into ../../skills (a separate
# clone of davidondrej/skills) written as absolute paths on this machine, so
# committing them would push links that resolve nowhere for anyone else.
.claude/
.cursor/

# Raw user-research data — interview audio, screen recordings, survey exports
# and signed consent forms. These carry identifiable voices and are submitted
# alongside the report rather than committed. The README explaining the naming
# convention stays, because the appendix references it.
docs/ux-research/appendix/raw/*
!docs/ux-research/appendix/raw/README.md

# Release signing. The upload key and its passwords are submitted separately and
# never committed — a keystore in version control is a keystore that has to be
# replaced. keystore.properties.example documents the four keys it must hold.
/keystore.properties
*.jks
*.keystore
